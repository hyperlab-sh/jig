{
  "name": "@jig-lang/parser",
  "description": "Parser for the Jig template engine. Forked from Edge.js by Harminder Virk.",
  "version": "1.1.0",
  "engines": {
    "node": ">=18.16.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/examples",
    "!build/tests",
    "!build/tests_helpers"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "precompile": "npm run lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.0.0-next.5",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0-next.3",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.0.0",
    "@poppinss/ts-exec": "^1.4.1",
    "@poppinss/utils": "6.10.1",
    "@release-it/conventional-changelog": "^10.0.3",
    "@types/acorn": "^6.0.4",
    "@types/astring": "^1.7.4",
    "@types/node": "^25.0.1",
    "c8": "^10.1.3",
    "dedent-js": "^1.0.1",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "release-it": "^19.1.0",
    "tsdown": "^0.17.3",
    "typescript": "^5.9.3",
    "youch": "^4.1.0-beta.13"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "astring": "^1.9.0",
    "edge-error": "^4.0.2",
    "@jig-lang/lexer": "workspace:^",
    "js-stringify": "^1.0.2"
  },
  "homepage": "https://github.com/hyperlab-sh/jig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperlab-sh/jig.git",
    "directory": "packages/parser"
  },
  "bugs": {
    "url": "https://github.com/hyperlab-sh/jig/issues"
  },
  "keywords": [
    "jig",
    "template",
    "template-engine",
    "parser",
    "code-generation"
  ],
  "author": "Saulo Vallory",
  "contributors": [
    "Harminder Virk <virk@adonisjs.com>"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./src/types.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireBranch": "main",
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): parser ${version}",
      "tagAnnotation": "parser-v${version}",
      "push": true,
      "tagName": "parser-v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "parser v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true,
      "publishPackageManager": "npm",
      "publishPath": "./.release/package.tgz",
      "publishArgs": [
        "--provenance",
        "--access",
        "public"
      ]
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "commitsOpts": {
          "path": "."
        },
        "gitRawCommitsOpts": {
          "path": "."
        }
      }
    },
    "hooks": {
      "before:npm:release": "bun run build && rm -rf .release && mkdir .release && bun pm pack --ignore-scripts --quiet --filename \"$PWD/.release/package.tgz\"",
      "after:npm:release": "rm -rf .release"
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
